
<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Network service: stations, lines and timetables. -->

  <ItemGroup>

    <!-- Shared MetroRail infrastructure. -->
    <ProjectReference
      Include="../../libs/MetroRail.Common/MetroRail.Common.csproj" />

    <!-- Physical railway network. -->
    <EmbeddedResource
      Include="Data/southern_line.json"
      LogicalName="southern_line.json" />

    <!-- Southern Line weekday inbound timetable. -->
    <EmbeddedResource
      Include="Data/Timetables/southern_line_weekday_inbound.csv"
      LogicalName="southern_line_weekday_inbound.csv" />

    <!-- Southern Line weekday outbound timetable. -->
    <EmbeddedResource
      Include="Data/Timetables/southern_line_weekday_outbound.csv"
      LogicalName="southern_line_weekday_outbound.csv" />

  </ItemGroup>

</Project>
