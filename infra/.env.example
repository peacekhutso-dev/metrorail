# Copy to infra/.env (git-ignored). Defaults work for local docker-compose.

# Pretend it's the 07:14 morning peak (demo only — remove for real times)
DEMO_TIME=07:14

# Billing: mock | sandbox | live. Put your Pay@ sandbox details here (never commit them).
PAYAT_MODE=mock
PAYAT_BASE_URL=
PAYAT_MERCHANT_ID=
PAYAT_API_KEY=
PAYAT_WEBHOOK_SECRET=mock-secret

# Keys (leave empty locally: services generate throwaway keys on start).
# Production: Ed25519 / X25519 private keys in PEM, from a secret manager.
IDENTITY_SIGNING_KEY=
TICKETING_ISSUER_KEY=
TICKETING_SCANNER_KEY=

CENTRIFUGO_TOKEN_SECRET=dev-token-secret-change-me-32-bytes!!
CENTRIFUGO_API_KEY=dev-api-key
