{
  "openapi": "3.1.1",
  "info": {
    "title": "MetroRail.Tools | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/trips",
      "description": "via the gateway"
    }
  ],
  "paths": {
    "/trips": {
      "get": {
        "tags": [
          "trips"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TripOut"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "trips"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/trips/{id}": {
      "put": {
        "tags": [
          "trips"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripOut"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "trips"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TripIn": {
        "required": [
          "name",
          "from_station_id",
          "to_station_id",
          "days",
          "usual_time",
          "train_no"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "from_station_id": {
            "type": "string"
          },
          "to_station_id": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usual_time": {
            "type": "string"
          },
          "train_no": {
            "type": [
              "null",
              "string"
            ]
          },
          "alert_delays": {
            "type": "boolean",
            "default": true
          },
          "leave_reminder": {
            "type": "boolean",
            "default": true
          },
          "leave_minutes": {
            "type": "integer",
            "format": "int32",
            "default": 10
          }
        }
      },
      "TripOut": {
        "required": [
          "id",
          "name",
          "from_station_id",
          "to_station_id",
          "days",
          "usual_time",
          "train_no",
          "alert_delays",
          "leave_reminder",
          "leave_minutes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "from_station_id": {
            "type": "string"
          },
          "to_station_id": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usual_time": {
            "type": "string"
          },
          "train_no": {
            "type": [
              "null",
              "string"
            ]
          },
          "alert_delays": {
            "type": "boolean"
          },
          "leave_reminder": {
            "type": "boolean"
          },
          "leave_minutes": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "trips"
    }
  ]
