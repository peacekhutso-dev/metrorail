    "/me": {
      "delete": {
        "description": "POPIA s24: delete the account. Other services purge on identity.user.deleted.\nPayment records are kept only as long as tax law requires, without contact details.",
        "operationId": "delete_me_me_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Delete Me",
        "tags": [
          "identity"
        ]
      },
      "get": {
        "operationId": "me_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
