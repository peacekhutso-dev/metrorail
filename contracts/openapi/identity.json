{
  "components": {
    "schemas": {
      "Consents": {
        "properties": {
          "nearest_station": {
            "default": false,
            "title": "Nearest Station",
            "type": "boolean"
          },
          "trip_alerts": {
            "default": true,
            "title": "Trip Alerts",
            "type": "boolean"
          },
          "usage_counts": {
            "default": true,
            "title": "Usage Counts",
            "type": "boolean"
          }
        },
        "title": "Consents",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "consents": {
            "$ref": "#/components/schemas/Consents"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "member_since": {
            "title": "Member Since",
            "type": "string"
          },
          "phone_masked": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone Masked"
          },
          "plan": {
            "title": "Plan",
            "type": "string"
          }
        },
        "required": [
          "id",
          "phone_masked",
          "email",
          "plan",
          "consents",
          "member_since"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "RefreshIn": {
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshIn",
        "type": "object"
      },
      "StartIn": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "title": "StartIn",
        "type": "object"
      },
      "StartOut": {
        "properties": {
          "challenge_id": {
            "title": "Challenge Id",
            "type": "string"
          },
          "channel": {
            "enum": [
              "sms",
              "email"
            ],
            "title": "Channel",
            "type": "string"
          },
          "dev_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dev Code"
          },
          "expires_in_s": {
            "title": "Expires In S",
            "type": "integer"
          },
          "sent_to": {
            "title": "Sent To",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "channel",
          "sent_to",
          "expires_in_s"
        ],
        "title": "StartOut",
        "type": "object"
      },
      "TokensOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in_s": {
            "default": 900,
            "title": "Expires In S",
            "type": "integer"
          },
          "is_new_user": {
            "title": "Is New User",
            "type": "boolean"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "user_id",
          "is_new_user"
        ],
        "title": "TokensOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyIn": {
        "properties": {
          "challenge_id": {
            "title": "Challenge Id",
            "type": "string"
          },
          "code": {
            "pattern": "^\\d{6}$",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "code"
        ],
        "title": "VerifyIn",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "MetroRail identity service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Jwks",
        "tags": [
          "identity",
          "ops"
        ]
      }
    },
