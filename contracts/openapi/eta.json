{
  "openapi": "3.1.1",
  "info": {
    "title": "MetroRail.Tools | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/eta",
      "description": "via the gateway"
    }
  ],
  "paths": {
    "/trains/{trainNo}/eta": {
      "get": {
        "tags": [
          "eta"
        ],
        "parameters": [
          {
            "name": "trainNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainEtaOut"
                }
              }
            }
          }
        }
      }
    },
    "/trains/{trainNo}/journey": {
      "get": {
        "tags": [
          "eta"
        ],
        "parameters": [
          {
            "name": "trainNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "board",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "alight",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JourneyEtaOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JourneyEtaOut": {
        "required": [
          "train_no",
          "state",
          "stationary_s",
          "board_station",
          "board_scheduled",
          "board_predicted",
          "board_in_min",
          "stops_until_board",
          "alight_station",
          "alight_predicted",
          "ride_min",
          "likely_from",
          "likely_to"
        ],
        "type": "object",
        "properties": {
          "train_no": {
            "type": "string"
          },
          "state": {
            "type": [
              "null",
              "string"
            ]
          },
          "stationary_s": {
            "type": "integer",
            "format": "int32"
          },
          "board_station": {
            "type": "string"
          },
          "board_scheduled": {
            "type": "string"
          },
          "board_predicted": {
            "type": "string"
          },
          "board_in_min": {
            "type": "integer",
            "format": "int32"
          },
          "stops_until_board": {
            "type": "integer",
            "format": "int32"
          },
          "alight_station": {
            "type": "string"
          },
          "alight_predicted": {
            "type": "string"
          },
          "ride_min": {
            "type": "integer",
            "format": "int32"
          },
          "likely_from": {
            "type": "string"
          },
          "likely_to": {
            "type": "string"
          }
        }
      },
      "StopEtaOut": {
        "required": [
          "station_id",
          "station_name",
          "scheduled",
          "predicted",
          "likely_from",
          "likely_to",
          "delay_min",
          "passed"
        ],
        "type": "object",
        "properties": {
          "station_id": {
            "type": "string"
          },
          "station_name": {
            "type": "string"
          },
          "scheduled": {
            "type": "string"
          },
          "predicted": {
            "type": "string"
          },
          "likely_from": {
            "type": "string"
          },
          "likely_to": {
            "type": "string"
          },
          "delay_min": {
            "type": "integer",
            "format": "int32"
          },
          "passed": {
            "type": "boolean"
          }
        }
      },
      "TrainEtaOut": {
        "required": [
          "train_no",
          "state",
          "stationary_s",
          "live",
          "model",
          "stops"
        ],
        "type": "object",
        "properties": {
          "train_no": {
            "type": "string"
          },
          "state": {
            "type": [
              "null",
              "string"
            ]
          },
          "stationary_s": {
            "type": "integer",
            "format": "int32"
          },
          "live": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopEtaOut"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "eta"
    }
  ]
}
