          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "ops"
        ]
      }
    },
    "/trains/{train_no}/eta": {
      "get": {
        "operationId": "train_eta_trains__train_no__eta_get",
        "parameters": [
          {
            "in": "path",
            "name": "train_no",
            "required": true,
            "schema": {
              "title": "Train No",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainEtaOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Train Eta",
        "tags": [
          "eta"
        ]
      }
    },
    "/trains/{train_no}/journey": {
      "get": {
        "description": "e.g. /trains/3412/journey?board=ST-RONDEBOSCH&alight=ST-CLAREMONT",
        "operationId": "journey_eta_trains__train_no__journey_get",
        "parameters": [
          {
            "in": "path",
            "name": "train_no",
            "required": true,
            "schema": {
              "title": "Train No",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "board",
            "required": true,
            "schema": {
              "title": "Board",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "alight",
            "required": true,
            "schema": {
              "title": "Alight",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JourneyEtaOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Journey Eta",
        "tags": [
          "eta"
        ]
      }
