{
  "openapi": "3.1.1",
  "info": {
    "title": "MetroRail.Tools | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/network",
      "description": "via the gateway"
    }
  ],
  "paths": {
    "/stations": {
      "get": {
        "tags": [
          "network"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StationOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stations/nearest": {
      "get": {
        "tags": [
          "network"
        ],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationOut"
                }
              }
            }
          }
        }
      }
    },
    "/lines": {
      "get": {
        "tags": [
          "network"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LineOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/lines/{lineId}/stops": {
      "get": {
        "tags": [
          "network"
        ],
        "parameters": [
          {
            "name": "lineId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LineStopOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trips/{trainNo}": {
      "get": {
        "tags": [
          "network"
        ],
        "parameters": [
          {
            "name": "trainNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripOut"
                }
              }
            }
          }
        }
      }
    },
    "/stations/{stationId}/departures": {
      "get": {
        "tags": [
          "network"
        ],
        "parameters": [
          {
            "name": "stationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DepartureOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/journeys": {
      "get": {
        "tags": [
          "network"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JourneyOption"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DepartureOut": {
        "required": [
          "train_no",
          "line_id",
          "direction",
          "terminus",
          "platform",
          "scheduled",
          "scheduled_min",
          "in_min"
        ],
        "type": "object",
        "properties": {
          "train_no": {
            "type": "string"
          },
          "line_id": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "terminus": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "scheduled": {
            "type": "string"
          },
          "scheduled_min": {
            "type": "integer",
            "format": "int32"
          },
          "in_min": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "JourneyOption": {
        "required": [
          "train_no",
          "line_id",
          "from_station",
          "to_station",
          "departs",
          "arrives",
          "duration_min",
          "platform"
        ],
        "type": "object",
        "properties": {
          "train_no": {
            "type": "string"
          },
          "line_id": {
            "type": "string"
          },
          "from_station": {
            "type": "string"
          },
          "to_station": {
            "type": "string"
          },
          "departs": {
            "type": "string"
          },
          "arrives": {
            "type": "string"
          },
          "duration_min": {
            "type": "integer",
            "format": "int32"
          },
          "platform": {
            "type": "string"
          },
          "changes": {
            "type": "integer",
            "format": "int32",
            "default": 0
          }
        }
      },
      "LineOut": {
        "required": [
          "id",
          "name",
          "colour"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "colour": {
            "type": "string"
          }
        }
      },
      "LineStopOut": {
        "required": [
          "seq",
          "station_id",
          "station_name",
          "minutes_from_origin"
        ],
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int32"
          },
          "station_id": {
            "type": "string"
          },
          "station_name": {
            "type": "string"
          },
          "minutes_from_origin": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "StationOut": {
        "required": [
          "id",
          "name",
          "lat",
          "lng",
          "lines"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StopTime": {
        "required": [
          "seq",
          "station_id",
          "station_name",
          "scheduled"
        ],
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int32"
          },
          "station_id": {
            "type": "string"
          },
          "station_name": {
            "type": "string"
          },
          "scheduled": {
            "type": "string"
          }
        }
      },
      "TripOut": {
        "required": [
          "train_no",
          "line_id",
          "direction",
          "terminus",
          "platform",
          "stops"
        ],
        "type": "object",
        "properties": {
          "train_no": {
            "type": "string"
          },
          "line_id": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "terminus": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopTime"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "network"
    }
  ]
}
