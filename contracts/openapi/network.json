    "/stations/{station_id}/departures": {
      "get": {
        "operationId": "departures_stations__station_id__departures_get",
        "parameters": [
          {
            "in": "path",
            "name": "station_id",
            "required": true,
            "schema": {
              "title": "Station Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(southbound|northbound)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Direction"
            }
          },
          {
            "description": "HH:MM SAST, default now",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "HH:MM SAST, default now",
              "title": "After"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 6,
              "maximum": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DepartureOut"
                  },
                  "title": "Response Departures Stations  Station Id  Departures Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Departures",
        "tags": [
          "network"
        ]
      }
    },
    "/trips/{train_no}": {
      "get": {
        "description": "Timetabled stop times for one train. Tracking/ETA services use this as the baseline.",
        "operationId": "get_trip_trips__train_no__get",
        "parameters": [
