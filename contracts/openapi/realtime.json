    "/token": {
      "get": {
        "description": "Token for Centrifugo's SSE endpoint. Subscriptions are decided here (server-side), so the\nphone only needs a plain EventSource: GET /connection/uni_sse?cf_connect={\"token\": ...}",
        "operationId": "connection_token_token_get",
        "parameters": [
          {
            "description": "comma-separated train numbers to follow, e.g. 3412,3420",
            "in": "query",
            "name": "trains",
            "required": false,
            "schema": {
              "default": "",
              "description": "comma-separated train numbers to follow, e.g. 3412,3420",
              "title": "Trains",
              "type": "string"
            }
          }
        ],
        "responses": {
