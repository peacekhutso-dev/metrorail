{
  "openapi": "3.1.1",
  "info": {
    "title": "MetroRail.Tools | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/ticketing",
      "description": "via the gateway"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "tags": [
          "ticketing"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/keys": {
      "get": {
        "tags": [
          "ticketing"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/purchases": {
      "post": {
        "tags": [
          "ticketing"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/tickets/{ticketId}/topup": {
      "post": {
        "tags": [
          "ticketing"
        ],
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TopUpIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/purchases/{id}": {
      "get": {
        "tags": [
          "ticketing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseOut"
                }
              }
            }
          }
        }
      }
    },
    "/tickets": {
      "get": {
        "tags": [
          "ticketing"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{id}": {
      "get": {
        "tags": [
          "ticketing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketOut"
                }
              }
            }
          }
        }
      }
    },
    "/validations": {
      "post": {
        "tags": [
          "ticketing"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "required": [
          "id",
          "name",
          "description",
          "price_cents",
          "trips"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "format": "int32"
          },
          "trips": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "PurchaseIn": {
        "required": [
          "product_id",
          "from_station_id",
          "to_station_id",
          "device_public_key"
        ],
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "from_station_id": {
            "type": "string"
          },
          "to_station_id": {
            "type": "string"
          },
          "device_public_key": {
            "type": "string"
          }
        }
      },
      "PurchaseOut": {
        "required": [
          "id",
          "status",
          "amount_cents",
          "description",
          "ticket_id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "amount_cents": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string"
          },
          "ticket_id": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TicketOut": {
        "required": [
          "id",
          "product_id",
          "product_name",
          "from_station_id",
          "to_station_id",
          "trips_total",
          "trips_used",
          "trips_left",
          "trip_in_progress",
          "trip_valid_until",
          "valid_to",
          "status",
          "cert"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "from_station_id": {
            "type": "string"
          },
          "to_station_id": {
            "type": "string"
          },
          "trips_total": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "trips_used": {
            "type": "integer",
            "format": "int32"
          },
          "trips_left": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "trip_in_progress": {
            "type": "boolean"
          },
          "trip_valid_until": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "valid_to": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "cert": {
            "type": "string"
          }
        }
      },
      "TopUpIn": {
        "required": [
          "trips"
        ],
        "type": "object",
        "properties": {
          "trips": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ValidateIn": {
        "required": [
          "qr",
          "train_no",
          "scanner_id"
        ],
        "type": "object",
        "properties": {
          "qr": {
            "type": "string"
          },
          "train_no": {
            "type": "string"
          },
          "scanner_id": {
            "type": "string"
          },
          "line_id": {
            "type": "string",
            "default": "LN-SOUTHERN"
          }
        }
      },
      "ValidateOut": {
        "required": [
          "result"
        ],
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "ticket_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "product_name": {
            "type": [
              "null",
              "string"
            ]
          },
          "route": {
            "type": [
              "null",
              "string"
            ]
          },
          "trip_no": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "trips_left": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "valid_until": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "new_trip_started": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ticketing"
    }
  ]
}
