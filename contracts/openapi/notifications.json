{
  "openapi": "3.1.1",
  "info": {
    "title": "MetroRail.Tools | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/notifications",
      "description": "via the gateway"
    }
  ],
  "paths": {
    "/alerts": {
      "get": {
        "tags": [
          "notifications"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlertOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alerts/unread-count": {
      "get": {
        "tags": [
          "notifications"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymousTypeOfint"
                }
              }
            }
          }
        }
      }
    },
    "/alerts/{id}/read": {
      "post": {
        "tags": [
          "notifications"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/alerts/read-all": {
      "post": {
        "tags": [
          "notifications"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertOut": {
        "required": [
          "id",
          "kind",
          "title",
          "body",
          "train_no",
          "read",
          "created_at"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "train_no": {
            "type": [
              "null",
              "string"
            ]
          },
          "read": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "AnonymousTypeOfint": {
        "required": [
          "unread"
        ],
        "type": "object",
        "properties": {
          "unread": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "notifications"
    }
  ]
}
