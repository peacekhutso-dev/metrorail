{
  "openapi": "3.1.1",
  "info": {
    "title": "MetroRail.Tools | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/tracking",
      "description": "via the gateway"
    }
  ],
  "paths": {
    "/positions": {
      "post": {
        "tags": [
          "tracking"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PositionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainOut"
                }
              }
            }
          }
        }
      }
    },
    "/trains/{trainNo}": {
      "get": {
        "tags": [
          "tracking"
        ],
        "parameters": [
          {
            "name": "trainNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainOut"
                }
              }
            }
          }
        }
      }
    },
    "/trains": {
      "get": {
        "tags": [
          "tracking"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TrainOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports": {
      "post": {
        "tags": [
          "tracking"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PositionIn": {
        "required": [
          "train_no",
          "lat",
          "lng",
          "at",
          "source"
        ],
        "type": "object",
        "properties": {
          "train_no": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "source": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReportIn": {
        "required": [
          "train_no",
          "station_id",
          "kind"
        ],
        "type": "object",
        "properties": {
          "train_no": {
            "type": "string"
          },
          "station_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "TrainOut": {
        "required": [
          "train_no",
          "lat",
          "lng",
          "state",
          "stationary_s",
          "last_station_id",
          "next_station_id",
          "at_station_id",
          "delay_min",
          "seen_at",
          "source"
        ],
        "type": "object",
        "properties": {
          "train_no": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "state": {
            "type": "string"
          },
          "stationary_s": {
            "type": "integer",
            "format": "int32"
          },
          "last_station_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "next_station_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "at_station_id": {
            "type": [
              "null",
              "string"
            ]
          },
          "delay_min": {
            "type": "integer",
            "format": "int32"
          },
          "seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "tracking"
    }
  ]
}
