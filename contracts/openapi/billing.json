{
  "openapi": "3.1.1",
  "info": {
    "title": "MetroRail.Tools | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/billing",
      "description": "via the gateway"
    }
  ],
  "paths": {
    "/payments": {
      "post": {
        "tags": [
          "billing"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/payments/{id}/mock-card": {
      "post": {
        "tags": [
          "billing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOut"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}/mock-3ds": {
      "post": {
        "tags": [
          "billing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOut"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}": {
      "get": {
        "tags": [
          "billing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOut"
                }
              }
            }
          }
        }
      }
    },
    "/receipts": {
      "get": {
        "tags": [
          "billing"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cards": {
      "get": {
        "tags": [
          "billing"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CardOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cards/{id}": {
      "delete": {
        "tags": [
          "billing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CardIn": {
        "required": [
          "number",
          "expiry",
          "cvv",
          "name"
        ],
        "type": "object",
        "properties": {
          "number": {
            "type": "string"
          },
          "expiry": {
            "type": "string"
          },
          "cvv": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "save": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "CardOut": {
        "required": [
          "id",
          "brand",
          "last4",
          "expiry"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "last4": {
            "type": "string"
          },
          "expiry": {
            "type": "string"
          }
        }
      },
      "OtpIn": {
        "required": [
          "otp"
        ],
        "type": "object",
        "properties": {
          "otp": {
            "type": "string"
          }
        }
      },
      "PayIn": {
        "required": [
          "purchase_id",
          "method",
          "saved_card_id"
        ],
        "type": "object",
        "properties": {
          "purchase_id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "saved_card_id": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PaymentOut": {
        "required": [
          "id",
          "purchase_id",
          "status",
          "amount_cents",
          "description",
          "card_form_url",
          "three_ds_url",
          "brand",
          "last4",
          "decline_reason"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "purchase_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "amount_cents": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string"
          },
          "card_form_url": {
            "type": [
              "null",
              "string"
            ]
          },
          "three_ds_url": {
            "type": [
              "null",
              "string"
            ]
          },
          "brand": {
            "type": [
              "null",
              "string"
            ]
          },
          "last4": {
            "type": [
              "null",
              "string"
            ]
          },
          "decline_reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "billing"
    }
  ]
}
